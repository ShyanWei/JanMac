diff --git a/web-app/src/containers/CoworkContextChip.tsx b/web-app/src/containers/CoworkContextChip.tsx
new file mode 100644
index 0000000..9b68124
--- /dev/null
+++ b/web-app/src/containers/CoworkContextChip.tsx
@@ -0,0 +1,112 @@
+import { IconRectangleVertical } from '@tabler/icons-react'
+import { Button } from '@/components/ui/button'
+import {
+  DropdownMenu,
+  DropdownMenuCheckboxItem,
+  DropdownMenuContent,
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger,
+} from '@/components/ui/dropdown-menu'
+import { useTranslation } from '@/i18n/react-i18next-compat'
+import { useAssistant } from '@/hooks/useAssistant'
+import { formatContextSize } from '@/lib/coworkModelControls'
+
+/**
+ * Context-window sizes offered straight from the composer.
+ *
+ * The values are the ones the engines actually serve -- 128K = 131072,
+ * 200K = 204800, 256K = 262144, 384K = 393216, 512K = 524288 -- so a choice
+ * here lines up with llama.cpp's `ctx_len` slider and with what a remote
+ * server reports as `--max-context`.
+ *
+ * It writes the active assistant's `max_context_tokens`, the same value the
+ * transport reads to trim or compact the conversation before sending, so this
+ * chip and the sampler popover can never disagree. `0` switches trimming off.
+ */
+export const CONTEXT_SIZE_PRESETS = [
+  131_072, 204_800, 262_144, 393_216, 524_288,
+] as const
+
+export function CoworkContextChip(): React.ReactElement | null {
+  const { t } = useTranslation()
+  const assistant = useAssistant((s) => s.currentAssistant)
+  const updateAssistant = useAssistant((s) => s.updateAssistant)
+  const parameters = assistant?.parameters ?? {}
+  const current = Number(parameters.max_context_tokens) || 0
+  const autoCompact =
+    parameters.auto_compact === true || parameters.auto_compact === 'true'
+
+  if (!assistant) return null
+
+  const patch = (next: Record<string, unknown>) =>
+    updateAssistant({
+      ...assistant,
+      parameters: { ...parameters, ...next },
+    })
+
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <Button
+          variant="ghost"
+          size="sm"
+          className="h-7 gap-1.5 rounded-full text-muted-foreground shrink-0 hover:bg-muted/60"
+          aria-label={t('common:coworkContext.a11y')}
+          title={
+            current > 0
+              ? `${formatContextSize(current)} · ${current.toLocaleString()}`
+              : t('common:coworkContext.unlimited')
+          }
+        >
+          <IconRectangleVertical size={12} className="shrink-0" />
+          <span className="font-mono text-xs tabular-nums">
+            {current > 0
+              ? formatContextSize(current)
+              : t('common:coworkContext.unset')}
+          </span>
+          {autoCompact && current > 0 && (
+            <span
+              className="size-1.5 shrink-0 rounded-full bg-primary"
+              title={t('common:coworkContext.autoCompact')}
+            />
+          )}
+        </Button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="start" className="w-64">
+        <DropdownMenuLabel>{t('common:coworkContext.title')}</DropdownMenuLabel>
+        <DropdownMenuRadioGroup
+          value={String(current)}
+          onValueChange={(value) => patch({ max_context_tokens: Number(value) })}
+        >
+          {CONTEXT_SIZE_PRESETS.map((tokens) => (
+            <DropdownMenuRadioItem key={tokens} value={String(tokens)}>
+              <span className="font-mono tabular-nums">
+                {formatContextSize(tokens)}
+              </span>
+              <span className="ml-1.5 text-xs text-muted-foreground">
+                {tokens.toLocaleString()}
+              </span>
+            </DropdownMenuRadioItem>
+          ))}
+          <DropdownMenuRadioItem value="0">
+            {t('common:coworkContext.unlimited')}
+          </DropdownMenuRadioItem>
+        </DropdownMenuRadioGroup>
+        <DropdownMenuSeparator />
+        <DropdownMenuCheckboxItem
+          checked={autoCompact}
+          disabled={current === 0}
+          onCheckedChange={(checked) => patch({ auto_compact: !!checked })}
+        >
+          {t('common:coworkContext.autoCompact')}
+        </DropdownMenuCheckboxItem>
+        <p className="px-2 pb-1 pt-1.5 text-xs leading-normal text-muted-foreground">
+          {t('common:coworkContext.hint')}
+        </p>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  )
+}
diff --git a/web-app/src/containers/__tests__/CoworkContextChip.test.tsx b/web-app/src/containers/__tests__/CoworkContextChip.test.tsx
new file mode 100644
index 0000000..a663891
--- /dev/null
+++ b/web-app/src/containers/__tests__/CoworkContextChip.test.tsx
@@ -0,0 +1,124 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { CONTEXT_SIZE_PRESETS, CoworkContextChip } from '../CoworkContextChip'
+
+let assistant: Record<string, unknown> | undefined
+const updateAssistant = vi.fn()
+
+vi.mock('@/hooks/useAssistant', () => ({
+  useAssistant: (selector: (state: Record<string, unknown>) => unknown) =>
+    selector({ currentAssistant: assistant, updateAssistant }),
+}))
+
+vi.mock('@/i18n/react-i18next-compat', () => ({
+  useTranslation: () => ({ t: (key: string) => key }),
+}))
+
+// Radix menus open on pointerdown, which `fireEvent.click` does not produce.
+const openMenu = async () => {
+  await userEvent.click(screen.getByRole('button'))
+}
+
+describe('CoworkContextChip', () => {
+  beforeEach(() => {
+    assistant = { id: 'a1', name: 'Assistant', parameters: {} }
+    updateAssistant.mockClear()
+  })
+
+  it('offers exactly the five sizes the engines serve, plus no trimming', () => {
+    expect(CONTEXT_SIZE_PRESETS).toEqual([
+      131_072, 204_800, 262_144, 393_216, 524_288,
+    ])
+  })
+
+  it('reads as unset when no context limit is configured', () => {
+    render(<CoworkContextChip />)
+    expect(screen.getByText('common:coworkContext.unset')).toBeTruthy()
+  })
+
+  it('writes max_context_tokens when a preset is chosen', async () => {
+    render(<CoworkContextChip />)
+    await openMenu()
+    await userEvent.click(screen.getByText('384K'))
+    expect(updateAssistant).toHaveBeenCalledWith(
+      expect.objectContaining({
+        id: 'a1',
+        parameters: { max_context_tokens: 393_216 },
+      })
+    )
+  })
+
+  // Trimming off has to be selectable, not merely the absence of a value: an
+  // assistant that already carries a limit needs a way back to "send it all".
+  it('turns trimming off through the "do not trim" item', async () => {
+    assistant = {
+      id: 'a1',
+      name: 'Assistant',
+      parameters: { max_context_tokens: 262_144 },
+    }
+    render(<CoworkContextChip />)
+    expect(screen.getByText('256K')).toBeTruthy()
+    await openMenu()
+    await userEvent.click(screen.getByText('common:coworkContext.unlimited'))
+    expect(updateAssistant).toHaveBeenCalledWith(
+      expect.objectContaining({ parameters: { max_context_tokens: 0 } })
+    )
+  })
+
+  it('keeps other sampler parameters when it writes the context size', async () => {
+    assistant = {
+      id: 'a1',
+      name: 'Assistant',
+      parameters: { temperature: 0.4 },
+    }
+    render(<CoworkContextChip />)
+    await openMenu()
+    await userEvent.click(screen.getByText('512K'))
+    expect(updateAssistant).toHaveBeenCalledWith(
+      expect.objectContaining({
+        parameters: { temperature: 0.4, max_context_tokens: 524_288 },
+      })
+    )
+  })
+
+  it('offers auto compact but refuses it while trimming is off', async () => {
+    render(<CoworkContextChip />)
+    await openMenu()
+    const item = screen
+      .getByText('common:coworkContext.autoCompact')
+      .closest('[role="menuitemcheckbox"]')
+    expect(item).toBeTruthy()
+    // No limit set means there is nothing to summarize, so the row is disabled.
+    expect(item?.getAttribute('data-disabled')).toBe('')
+  })
+
+  it('checks the row matching the chip, and enables auto compact once limited', async () => {
+    assistant = {
+      id: 'a1',
+      name: 'Assistant',
+      parameters: { max_context_tokens: 204_800, auto_compact: true },
+    }
+    render(<CoworkContextChip />)
+    expect(screen.getByText('200K')).toBeTruthy()
+    await openMenu()
+    // The size appears twice with the menu open: the chip and its row.
+    const row = screen
+      .getAllByText('200K')
+      .map((node) => node.closest('[role="menuitemradio"]'))
+      .find(Boolean)
+    expect(row?.getAttribute('data-state')).toBe('checked')
+    const compact = screen
+      .getByText('common:coworkContext.autoCompact')
+      .closest('[role="menuitemcheckbox"]')
+    expect(compact?.hasAttribute('data-disabled')).toBe(false)
+    expect(compact?.getAttribute('data-state')).toBe('checked')
+  })
+
+  it('renders nothing when there is no assistant to write to', () => {
+    assistant = undefined
+    const { container } = render(<CoworkContextChip />)
+    expect(container.firstChild).toBeNull()
+    expect(updateAssistant).not.toHaveBeenCalled()
+  })
+})
