@@ -1,28 +1,68 @@
 import { create } from 'zustand'
 import { persist, createJSONStorage } from 'zustand/middleware'
 import { localStorageKey } from '@/constants/localStorage'
 import { backendStorage } from '@/lib/backendStorage'
+import {
+  DEFAULT_MAX_AGENT_STEPS,
+  DEFAULT_MAX_SESSION_TOKENS,
+} from '@/lib/coworkBudget'
 
 type CoworkConfigState = {
   /**
    * Open the sandboxed shell's network namespace for Cowork runs. On by
    * default: an agent surface without package installs or curl is crippled
    * for the work it exists to do, and the OS sandbox still confines the
    * filesystem either way. Chat's shell is unaffected — its network is closed
    * unconditionally.
    */
   networkEnabled: boolean
   setNetworkEnabled: (value: boolean) => void
+  /**
+   * Ceiling on the tokens one Cowork request may spend, charged on the
+   * *marginal* tokens it adds (see `recordSpend`): replayed history is not
+   * re-billed, so this bounds new work, not context size. `0` removes the
+   * ceiling, which is what a large-window model wants — the cap exists to
+   * catch runaway loops, not to ration a model's own context window.
+   *
+   * A model can override this from its sampler popover (`session_token_budget`
+   * under Output control); the model's value wins when it is set.
+   */
+  tokenBudget: number
+  setTokenBudget: (value: number) => void
+  /**
+   * Model turns one Cowork request may take before it stops with "Stopped at
+   * {{max}} steps". `0` removes the step cap: a long task on a large-window
+   * model should be bounded by its context and the user's stop button, not by a
+   * turn count that was sized for small local models.
+   */
+  maxSteps: number
+  setMaxSteps: (value: number) => void
 }
 
 export const useCoworkConfig = create<CoworkConfigState>()(
   persist(
     (set) => ({
       networkEnabled: true,
       setNetworkEnabled: (networkEnabled) => set({ networkEnabled }),
+      tokenBudget: DEFAULT_MAX_SESSION_TOKENS,
+      setTokenBudget: (tokenBudget) =>
+        set({
+          tokenBudget:
+            Number.isFinite(tokenBudget) && tokenBudget > 0
+              ? Math.trunc(tokenBudget)
+              : 0,
+        }),
+      maxSteps: DEFAULT_MAX_AGENT_STEPS,
+      setMaxSteps: (maxSteps) =>
+        set({
+          maxSteps:
+            Number.isFinite(maxSteps) && maxSteps > 0
+              ? Math.trunc(maxSteps)
+              : 0,
+        }),
     }),
     {
       name: localStorageKey.settingCowork,
       storage: createJSONStorage(() => backendStorage),
       skipHydration: true,
     }
